<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  키보드 익스텐션(TadakKeyboard) 프라이버시 매니페스트.
  1.3.2 백로그 14 (나) — 보안 규칙 N4′(사용자 승인 2026-10-23): 키보드에 Firebase Crashlytics **하나**가 들어왔다.
    설정 「키보드 크래시 보고」(기본 켜짐, 2026-10-26) ∧ 전체 접근일 때만 시작하지만, 선언은 "켤 수 있는 상태에서 수집될 수 있는 것"을 적는다
    (앱 매니페스트와 같은 원칙 — 사용자별 현재 설정이 아니다). 입력한 텍스트·문맥·클립보드는 어디에도 실리지 않는다(security.md 1순위).
  수집 3종 — PDR `docs/design-reviews/keyboard-crashlytics.md` 6-5 후보 그대로. **ASC App Privacy 답안 대조(6-4) 전 잠정**이다.
    CrashData             — 스택 트레이스·예외 정보(FirebaseCrashlytics 번들 매니페스트도 같은 항목·목적)
    OtherDiagnosticData   — 기기 모델·OS·앱 버전, 전송 메타데이터(Crashlytics·Installations·GoogleDataTransport 번들 매니페스트)
    DeviceID              — Crashlytics 설치 UUID·Firebase 설치 ID(FID). SDK 번들 매니페스트에는 없지만 공식 개인정보 페이지가
                            수집 항목으로 적는다 — 그 수집을 켠 주체는 우리라 직접 적는다(앱 매니페스트의 Crashlytics 선언과 같은 판단)
  Linked = false: 계정·로그인이 없고 `setUserID`를 부르지 않는다(telemetry-gate 검사 C가 막는다). Tracking = false: 광고·IDFA 계열 미링크
    (`tools/archive-compliance-check.sh` 4절). SDK 번들 매니페스트(Firebase_*·GoogleDataTransport_*·GoogleUtilities_*.bundle)는 자기
    required-reason을 스스로 선언하므로 아래 UserDefaults 사유는 키보드 자기 코드의 것만이다.
  (가) 종료 흔적은 이 선언과 무관하다 — 키보드는 그것을 기기 밖으로 보내지 않는다(전송은 설정 앱 매니페스트 몫, PDR 6-5).
  이 목록을 바꾸면 `tools/archive-compliance-check.sh`의 EXPECTED_EXT_COLLECTED와 `ci_scripts/ci_post_clone.sh` 6-2(3)도 같이 바꾼다.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
